# Binaries.
#
# The leading slash on /icpt matters: a bare "icpt" would also match the
# cmd/icpt DIRECTORY, so the CLI's own source would be silently untracked.
/bin/
/dist/
/icpt
*.exe
*.test

# Coverage
*.out
coverage.*

# Local environment — never commit a DSN
.env
.env.*
!.env.example

# Ad-hoc route dumps. A dump you want diffed in review is committed on purpose.
/routes.local.json

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Runtime config written by the serverless example at examples/quotes.json.
/examples/quotes.json
